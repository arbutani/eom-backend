# Server
PORT=3000
NODE_ENV=production

# CORS (comma-separated list of allowed origins; required in production)
CORS_ORIGINS=https://example.com,https://www.example.com

# Database (either DATABASE_URL or the individual variables below)
DATABASE_URL=postgres://user:password@hostname:5432/database

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=appdb
DB_SSL=false
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_PRIVATE_KEY=replace-with-your-private-key

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Frontend
FRONTEND_URL=https://example.com
